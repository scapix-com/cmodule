# Generated package config in CMAKE_FIND_PACKAGE_REDIRECTS_DIR.
#
# find_package() checks this directory before anything else (Find modules included, even with MODULE),
# so after the provider writes these files and declines the request, built-in find_package()
# handles version compatibility, components, REQUIRED/QUIET and result variables.

function(cmodule_write_package recipe package)
  string(TOLOWER "${package}" lower_package)

  get_property(written GLOBAL PROPERTY CMODULE_WRITTEN_${lower_package})
  if(written)
    return()
  endif()

  cmodule_recipe_get(${recipe} VERSION version)
  cmodule_recipe_get(${recipe} COMPATIBILITY compatibility)
  cmodule_recipe_get(${recipe} VARIABLES variables)
  cmodule_recipe_get(${recipe} COMPONENTS components)

  set(dir "${CMAKE_FIND_PACKAGE_REDIRECTS_DIR}")

  write_basic_package_version_file("${dir}/${lower_package}-config-version.cmake"
    VERSION ${version}
    COMPATIBILITY ${compatibility}
    ARCH_INDEPENDENT
  )

  # Use ${CMAKE_FIND_PACKAGE_NAME} in generated code: package name case is that of the find_package() call.

  set(pkg "\${CMAKE_FIND_PACKAGE_NAME}")

  string(CONCAT config
    "# Generated by cmodule: package ${package}, recipe ${recipe} ${version}\n"
    "\n"
  )

  cmodule_recipe_get(${recipe} COMPONENT_TARGETS component_targets)

  foreach(entry IN LISTS variables)
    if(NOT entry MATCHES "^([^=+]+)(\\+?=)(.*)$")
      message(FATAL_ERROR "cmodule recipe ${recipe}: VARIABLES entry must be <var>=<value> or <var>+=<value>: ${entry}")
    endif()
    set(var "${CMAKE_MATCH_1}")
    set(op "${CMAKE_MATCH_2}")
    cmodule_expand(${recipe} "${CMAKE_MATCH_3}" value)
    if(op STREQUAL "+=")
      string(APPEND config "list(APPEND ${var} [==[${value}]==])\n")
    else()
      string(APPEND config "set(${var} [==[${value}]==])\n")
    endif()
  endforeach()

  # Component is found if listed in COMPONENTS, or its target exists (COMPONENT_TARGETS).

  string(APPEND config
    "\n"
    "set(_cmodule_components [==[${components}]==])\n"
    "foreach(_cmodule_component IN LISTS ${pkg}_FIND_COMPONENTS)\n"
    "  string(REPLACE \"{component}\" \"\${_cmodule_component}\" _cmodule_target [==[${component_targets}]==])\n"
    "  if(_cmodule_component IN_LIST _cmodule_components OR (_cmodule_target AND TARGET \"\${_cmodule_target}\"))\n"
    "    set(${pkg}_\${_cmodule_component}_FOUND TRUE)\n"
    "  elseif(${pkg}_FIND_REQUIRED_\${_cmodule_component})\n"
    "    set(${pkg}_FOUND FALSE)\n"
    "    set(${pkg}_NOT_FOUND_MESSAGE \"cmodule recipe ${recipe} does not provide component \${_cmodule_component}\")\n"
    "  endif()\n"
    "endforeach()\n"
    "unset(_cmodule_component)\n"
    "unset(_cmodule_components)\n"
    "unset(_cmodule_target)\n"
    "\n"
    "# Find modules also set upper-case <PACKAGE>_FOUND (e.g. BZIP2_FOUND), some consumers check it.\n"
    "string(TOUPPER \"${pkg}\" _cmodule_upper)\n"
    "if(NOT DEFINED ${pkg}_FOUND OR ${pkg}_FOUND)\n"
    "  set(\${_cmodule_upper}_FOUND TRUE)\n"
    "else()\n"
    "  set(\${_cmodule_upper}_FOUND FALSE)\n"
    "endif()\n"
    "unset(_cmodule_upper)\n"
  )

  if(COMMAND cmodule_${recipe}_config)
    set(extra "")
    cmake_language(CALL cmodule_${recipe}_config ${package} extra)
    string(APPEND config "\n# From recipe ${recipe}\n${extra}\n")
  endif()

  file(WRITE "${dir}/${lower_package}-config.cmake" "${config}")
  set_property(GLOBAL PROPERTY CMODULE_WRITTEN_${lower_package} TRUE)
endfunction()
